  "source": "draft/AdmireVega.md",
  "lines": [
    {
      "id": "vo004",
      "type": "narration",
      "speakerId": "Voice-over",
      "speakerLabel": "旁白",
      "showSpeaker": false,
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/vo004.wav",
      "spokenText": "深夜の走路で、白線だけが月明かりに浮かんでいた。",
      "subtitleJa": "深夜の走路で、白線だけが月明かりに浮かんでいた。",
      "subtitleZh": "深夜的跑道上，只有白线浮在月光里。"
    },
    {
      "id": "tr018",
      "type": "dialogue",
      "speakerId": "Trainer",
      "speakerLabel": "训练员",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/tr018.wav",
      "spokenText": "アドマイヤベガさん、こんな時間に。",
      "subtitleJa": "アドマイヤベガさん、こんな時間に。",
      "subtitleZh": "爱慕织姬，这么晚了还在这里。"
    },
    {
      "id": "av014",
      "type": "dialogue",
      "speakerId": "admire_vega",
      "speakerLabel": "爱慕织姬",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/av014.wav",
      "spokenText": "眠れなかっただけ。",
      "subtitleJa": "眠れなかっただけ。",
      "subtitleZh": "只是睡不着而已。"
    },
    {
      "id": "tr015",
      "type": "dialogue",
      "speakerId": "Trainer",
      "speakerLabel": "训练员",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/tr015.wav",
      "spokenText": "夏の大三角は、あそこだ。",
      "subtitleJa": "夏の大三角は、あそこだ。",
      "subtitleZh": "夏季大三角，就在那里。"
    },
    {
      "id": "tr016",
      "type": "dialogue",
      "speakerId": "Trainer",
      "speakerLabel": "训练员",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/tr016.wav",
      "spokenText": "ベガ、デネブ、アルタイル。",
      "subtitleJa": "ベガ、デネブ、アルタイル。",
      "subtitleZh": "织女星、天津四、牛郎星。"
    },
    {
      "id": "av013",
      "type": "dialogue",
      "speakerId": "admire_vega",
      "speakerLabel": "爱慕织姬",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/av013.wav",
      "spokenText": "あなたも、ベガを見るのね。",
      "subtitleJa": "あなたも、ベガを見るのね。",
      "subtitleZh": "你也会看织女星啊。"
    },
    {
      "id": "tr019",
      "type": "dialogue",
      "speakerId": "Trainer",
      "speakerLabel": "训练员",
      "background": "track_night",
      "characters": [
        { "speakerId": "Trainer", "slot": "center_left", "spriteScale": 0.78 },
        { "speakerId": "admire_vega", "slot": "center_right", "spriteScale": 0.84, "spriteVariant": "ZF" }
      ],
      "audio": "draft/admire_vega_audio/tr019.wav",
      "spokenText": "星を見ると、少し呼吸が戻る。",
      "subtitleJa": "星を見ると、少し呼吸が戻る。",
      "subtitleZh": "看着星星时，呼吸会稍微平稳一点。"
    }
  ],
