{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "outfit_id": {
      "type": "string",
      "minLength": 1
    },
    "atlas": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "image",
        "data"
      ],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "frame_width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frame_height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "anchor_x": {
          "type": "number",
          "minimum": 0
        },
        "anchor_y": {
          "type": "number",
          "minimum": 0
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "frame_width",
        "frame_height",
        "anchor_x",
        "anchor_y",
        "scale"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "footprint_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "footprint_height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset_y": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "footprint_width",
        "footprint_height",
        "offset_y"
      ],
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "properties": {
        "speed_px_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "idle_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "speed_px_per_second",
        "idle_after_ms"
      ],
      "additionalProperties": false
    },
    "default_direction": {
      "type": "string",
      "enum": [
        "down",
        "left",
        "right",
        "up"
      ]
    },
    "animations": {
      "type": "object",
      "properties": {
        "stand": {
          "type": "object",
          "properties": {
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "loop": {
              "type": "boolean"
            },
            "directions": {
              "type": "object",
              "properties": {
                "down": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "left": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "right": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "up": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "down",
                "left",
                "right",
                "up"
              ],
              "additionalProperties": false
            },
            "fallback": {
              "type": "null"
            }
          },
          "required": [
            "fps",
            "loop",
            "directions"
          ],
          "additionalProperties": false
        },
        "walk": {
          "type": "object",
          "properties": {
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "loop": {
              "type": "boolean"
            },
            "directions": {
              "type": "object",
              "properties": {
                "down": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "left": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "right": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "up": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "fallback": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "stand",
                    "walk",
                    "idle"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fps",
            "loop",
            "directions"
          ],
          "additionalProperties": false
        },
        "idle": {
          "type": "object",
          "properties": {
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            },
            "loop": {
              "type": "boolean"
            },
            "directions": {
              "type": "object",
              "properties": {
                "down": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "left": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "right": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "up": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "fallback": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "stand",
                    "walk",
                    "idle"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "fps",
            "loop",
            "directions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stand",
        "walk",
        "idle"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "actor_id",
    "display_name",
    "outfit_id",
    "atlas",
    "render",
    "movement",
    "default_direction",
    "animations"
  ],
  "additionalProperties": false
}
