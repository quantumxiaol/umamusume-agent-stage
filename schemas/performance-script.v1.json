                        "properties": {
                          "cue_id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          "role_id": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          "type": {
