    "schema_version": {
      "type": "string",
      "const": "performance_script.v1"
    },
    "performance_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "cast": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "character_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "outfit_id": {
            "default": "uniform",
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
