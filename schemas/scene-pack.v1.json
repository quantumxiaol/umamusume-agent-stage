    "spawns": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "facing": {
            "default": "down",
            "type": "string",
            "enum": [
              "down",
              "left",
              "right",
              "up"
            ]
          }
        },
        "required": [
          "id",
          "position",
          "facing"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "target_scene_id": {
            "type": "string",
            "minLength": 1
          },
          "target_spawn_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "position",
          "target_scene_id",
          "target_spawn_id"
        ],
        "additionalProperties": false
      }
    },
    "activity_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "activity_id": {
            "type": "string",
            "minLength": 1
          },
          "anchor_id": {
            "type": "string"
          },
          "loop": {
            "default": false,
            "type": "boolean"
          },
          "points": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
