    "props": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "building",
              "tree",
              "bench",
              "fountain",
              "vending_machine",
              "sign"
            ]
          },
          "bounds": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "label": {
            "type": "string"
          },
          "y_sort": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "bounds",
          "y_sort"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "facing": {
            "type": "string",
            "enum": [
              "down",
              "left",
              "right",
              "up"
            ]
          },
          "slots": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "facing": {
                  "type": "string",
                  "enum": [
                    "down",
                    "left",
                    "right",
                    "up"
                  ]
                }
              },
              "required": [
                "id",
                "position"
              ],
              "additionalProperties": false
            }
          },
          "interactions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "tags",
          "id",
          "display_name",
          "description",
          "position",
          "slots",
          "interactions"
        ],
        "additionalProperties": false
