{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "live_stage.v1"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "tile": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "facing": {
            "type": "string",
            "enum": [
              "down",
              "left",
              "right",
              "up"
            ]
          },
          "locomotion": {
            "type": "string",
            "enum": [
              "stand",
              "walk",
              "idle"
            ]
          },
          "control_owner": {
            "type": "string",
            "enum": [
              "player",
              "agent",
              "script",
              "system"
            ]
          },
          "following_actor_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "follow_distance_tiles": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "nearby_anchors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "actor_id",
          "tile",
          "facing",
          "locomotion",
          "control_owner",
          "following_actor_id",
          "follow_distance_tiles",
          "nearby_anchors"
        ],
        "additionalProperties": false
      }
    },
    "remote_actors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "actor_id",
          "scene_id"
        ],
        "additionalProperties": false
      }
    },
    "travel_destinations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "default": "",
            "type": "string"
          },
          "spawn_ids": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "scene_id",
          "display_name",
          "spawn_ids"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "default": "",
            "type": "string"
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "available_slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "display_name",
          "description",
          "tags",
          "available_slots"
        ],
        "additionalProperties": false
      }
    },
    "activity_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "activity_id": {
            "type": "string",
            "minLength": 1
          },
          "loop": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "activity_id",
          "loop"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_scene_id": {
            "type": "string",
            "minLength": 1
          },
          "target_spawn_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "target_scene_id",
          "target_spawn_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "stage_id",
    "scene_id",
    "actors",
    "remote_actors",
    "travel_destinations",
    "anchors",
    "activity_paths",
    "portals"
  ],
  "additionalProperties": false
}
