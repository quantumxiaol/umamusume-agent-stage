{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.move_to"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "slot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id",
        "anchor_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.face"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "facing": {
          "type": "string",
          "enum": [
            "down",
            "left",
            "right",
            "up"
          ]
        }
      },
      "required": [
        "type",
        "actor_id",
        "facing"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.face_actor"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "target_actor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id",
        "target_actor_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.approach"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "target_actor_id": {
          "type": "string",
          "minLength": 1
        },
        "distance_tiles": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "preferred_side": {
          "default": "above",
          "type": "string",
          "enum": [
            "nearest",
            "above",
            "below",
            "left",
            "right"
          ]
        }
      },
      "required": [
        "type",
        "actor_id",
        "target_actor_id",
        "distance_tiles",
        "preferred_side"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.follow"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "target_actor_id": {
          "type": "string",
          "minLength": 1
        },
        "distance_tiles": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "preferred_side": {
          "default": "above",
          "type": "string",
          "enum": [
            "nearest",
            "above",
            "below",
            "left",
            "right"
          ]
        }
      },
      "required": [
        "type",
        "actor_id",
        "target_actor_id",
        "distance_tiles",
        "preferred_side"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.stop_follow"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.travel_to_scene"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "target_scene_id": {
          "type": "string",
          "minLength": 1
        },
        "target_spawn_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id",
        "target_scene_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "actor.stop"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dialogue.say"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "actor_id",
        "text"
      ],
      "additionalProperties": false
    }
  ]
}
